# AgriLink Backend Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# SECURITY CONFIGURATION (REQUIRED)
# =============================================================================

# SECRET_KEY: Used for session signing and CSRF protection
# CRITICAL: Generate a secure random key for production!
# Generate with: python -c 'import secrets; print(secrets.token_hex(32))'
# Must be at least 32 characters long
# DO NOT use this placeholder - generate your own!
SECRET_KEY=REDACTED_SECRET_KEY

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://localhost/agrilink

# =============================================================================
# FLASK SERVER CONFIGURATION
# =============================================================================

# Environment: development, production, or testing
FLASK_ENV=development

# Server host and port
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# Debug mode (NEVER use true in production!)
FLASK_DEBUG=false

# =============================================================================
# CORS CONFIGURATION
# =============================================================================

# Allowed frontend origins (comma-separated)
# CRITICAL: Never use '*' in production - specify exact origins
# Example for production: https://app.agrilink.com,https://admin.agrilink.com
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:3000

# Base URL for verification and password reset links (no trailing slash)
FRONTEND_URL=http://localhost:5173

# =============================================================================
# EMAIL VERIFICATION
# =============================================================================
# Sender address for verification emails
EMAIL_FROM=noreply@agrilink.example.com
# Token expiry in hours (default 24)
EMAIL_VERIFICATION_TOKEN_EXPIRY_HOURS=24

# Optional: SMTP for sending emails (if not set, links are logged only)
# MAIL_SERVER=smtp.example.com
# MAIL_PORT=587
# MAIL_USE_TLS=true
# MAIL_USERNAME=
# MAIL_PASSWORD=

# =============================================================================
# SESSION CONFIGURATION
# =============================================================================

# Require HTTPS for session cookies (set to 'false' only in development)
SESSION_COOKIE_SECURE=false

# =============================================================================
# RATE LIMITING CONFIGURATION
# =============================================================================

# Redis URL for distributed rate limiting (optional)
# For production with multiple servers, use Redis
# Example: redis://localhost:6379/0
# Leave empty to use in-memory storage (single server only)
REDIS_URL=

# =============================================================================
# CLOUDINARY CONFIGURATION (REQUIRED FOR IMAGE UPLOADS)
# =============================================================================

# Get these from your Cloudinary dashboard: https://console.cloudinary.com/
# CRITICAL: Never commit actual credentials - use environment variables!
CLOUDINARY_CLOUD_NAME=REDACTED_CLOUDINARY_CLOUD_NAME
CLOUDINARY_API_KEY=REDACTED_CLOUDINARY_API_KEY
CLOUDINARY_API_SECRET=REDACTED_CLOUDINARY_API_SECRET

# For local development only: if you do not have Cloudinary credentials yet,
# you can leave the above empty and the server will use a safe development
# fallback image (only when FLASK_ENV=development). Do NOT rely on the
# fallback in production; configure real credentials before deploying.

# =============================================================================
# PRODUCTION DEPLOYMENT NOTES
# =============================================================================
# 1. Set FLASK_ENV=production
# 2. Generate and set a strong SECRET_KEY
# 3. Set SESSION_COOKIE_SECURE=true
# 4. Configure specific FRONTEND_ORIGINS (no wildcards)
# 5. Use Redis for REDIS_URL if running multiple instances
# 6. Use a production WSGI server (gunicorn, uwsgi)
# 7. Enable HTTPS/TLS at load balancer or reverse proxy
